# ============================================================
# Portal TE — Configuração local (sem Supabase)
# ============================================================
# Copie para .env e ajuste os valores. NUNCA versionar .env.
# No docker-compose, DATABASE_URL é sobrescrita pra usar hostname "postgres".

# Banco de dados Postgres (Docker local: ver docker-compose.yml)
DATABASE_URL="postgresql://portal:portal_dev_password@localhost:5432/portal_te?schema=public"

# JWT (gere com: openssl rand -base64 64)
JWT_SECRET="troque-por-um-segredo-aleatorio-de-64-chars"
JWT_REFRESH_SECRET="troque-por-outro-segredo-aleatorio-diferente"

# OAuth Google (obtenha em https://console.cloud.google.com/apis/credentials)
# Redirect URI autorizado: http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# URL pública do app (usada em callbacks OAuth e links de e-mail)
PUBLIC_APP_URL="http://localhost:3000"

# Diretório de uploads (caminho absoluto). Crie a pasta antes.
UPLOAD_DIR="/var/lib/portal-te/uploads"

# SMTP para reset de senha e notificações
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"       # true se porta 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Portal TE <no-reply@colegiopositivo.com.br>"

# Fonte da migração (script scripts/migrate-from-supabase.ts)
# Só precisa preencher no momento da migração; pode remover depois.
MIGRATE_SUPABASE_URL=""
MIGRATE_SUPABASE_SERVICE_ROLE_KEY=""
