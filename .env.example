# ============================================================
# Portal TE — variáveis de ambiente
# ============================================================
# Copie para .env (`cp .env.example .env`) e ajuste. NUNCA versione o .env.
# Descrição completa de cada variável: seção 5 do README.md

# ---------- OBRIGATÓRIAS ----------

# Conexão com o Postgres.
# No docker compose esta variável é SOBRESCRITA para usar o host "postgres".
DATABASE_URL="postgresql://portal:portal_dev_password@localhost:5432/portal_te?schema=public"

# Segredos JWT — gere cada um com: openssl rand -base64 64
# Devem ser DIFERENTES entre si. Trocá-los desloga todos os usuários.
JWT_SECRET="troque-por-um-segredo-aleatorio-de-64-chars"
JWT_REFRESH_SECRET="troque-por-outro-segredo-aleatorio-diferente"

# URL pública do app (callbacks OAuth e links enviados por e-mail).
PUBLIC_APP_URL="http://localhost:3000"

# Diretório absoluto dos uploads (avatares e mídias). Crie a pasta antes.
# No docker compose é sobrescrito e apontado para o volume portal_uploads.
UPLOAD_DIR="/var/lib/portal-te/uploads"

# ---------- OPCIONAIS: login com Google ----------
# https://console.cloud.google.com/apis/credentials (Web application)
# Redirect URI autorizado: ${PUBLIC_APP_URL}/api/auth/google/callback
# Vazio = botão "Entrar com Google" não funciona.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ---------- OPCIONAIS: SMTP (reset de senha e notificações) ----------
# SMTP_HOST vazio = nenhum e-mail é enviado; o conteúdo cai no log do app.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"       # "true" apenas para a porta 465
SMTP_USER=""              # vazio = conexão sem autenticação
SMTP_PASS=""
SMTP_FROM="Portal TE <no-reply@colegiopositivo.com.br>"

# ---------- OPCIONAIS: migração única de dados do Supabase ----------
# Ver MIGRACAO_POSTGRES.md. Preencha só durante a migração e REMOVA depois.
MIGRATE_SUPABASE_URL=""
MIGRATE_SUPABASE_SERVICE_ROLE_KEY=""
