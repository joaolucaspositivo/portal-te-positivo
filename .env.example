# ============================================================
# Portal TE — Configuração local
# ============================================================
# Copie para .env e ajuste os valores. NUNCA versionar .env.

# Banco de dados Postgres
# Docker local padrão: docker-compose.yml publica 5433 no host e 5432 no container.
DATABASE_URL="postgresql://portal:portal_dev_password@localhost:5433/portal_te?schema=public"

# JWT
# Gere valores reais apenas no .env:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET="troque-por-um-segredo-local"
JWT_REFRESH_SECRET="troque-por-outro-segredo-local"

# OAuth Google
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# URL pública do app local
PUBLIC_APP_URL="http://localhost:8080"

# Diretório de uploads local
UPLOAD_DIR="C:/Users/109221/Documents/Portal TE/portal-uploads"

# SMTP para reset de senha
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Portal TE <no-reply@example.com>"