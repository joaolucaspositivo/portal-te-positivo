# ============================================================
# Portal TE — Produção
# Copie para .env.production na VPS e ajuste os valores.
# Nunca versionar .env.production real.
# ============================================================

NODE_ENV="production"

# Banco de dados
DATABASE_URL="postgresql://portal:troque-esta-senha@postgres:5432/portal_te?schema=public"

# JWT
# Gere com:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET="troque-por-um-segredo-forte"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte"

# URL pública
PUBLIC_APP_URL="https://portal-te.seudominio.com.br"

# Uploads
UPLOAD_DIR="/app/uploads"

# SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Portal TE <no-reply@example.com>"

# OAuth Google, uso futuro/opcional
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""